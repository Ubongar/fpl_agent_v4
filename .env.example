# Copy this file to .env and fill in real values before running anything.
# config.py loads .env automatically via python-dotenv.

# --- Database (required before ANY ingestion, backfill, or model code runs) ---
DATABASE_URL=postgresql://fpl_user:changeme@localhost:5432/fpl_agent

# --- LLM (agent/llm_agent.py) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=olori-image

# --- FPL season state ---
# Update this every gameweek, or drive it from the FPL API's "current event" instead.
FPL_CURRENT_GW=4
