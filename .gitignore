.dmypy.json
dmypy.json
.ruff_cache/
.pyre/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Streamlit ----------
.streamlit/secrets.toml

# ---------- Databases / dumps ----------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# ---------- Logs / outputs ----------
*.log
logs/
outputs/
data/raw/
data/processed/

